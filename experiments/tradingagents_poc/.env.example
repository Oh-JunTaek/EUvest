# TradingAgents POC Environment Variables
# Copy this to .env and fill in your API keys

# ============================================================
# NVIDIA NIM API Key (Required for NVIDIA NIM provider)
# Get your key from: https://build.nvidia.com/
# ============================================================
NVIDIA_API_KEY=

# ============================================================
# Optional: Alpha Vantage API Key (for fundamental data fallback)
# Get from: https://www.alphavantage.co/support/#api-key
# ============================================================
ALPHA_VANTAGE_API_KEY=

# ============================================================
# Optional: FRED API Key (for macro data)
# Get from: https://fred.stlouisfed.org/docs/api/api_key.html
# ============================================================
FRED_API_KEY=

# ============================================================
# Optional: OpenAI API Key (if using OpenAI provider)
# ============================================================
OPENAI_API_KEY=

# ============================================================
# Optional: Anthropic API Key (if using Anthropic provider)
# ============================================================
ANTHROPIC_API_KEY=

# ============================================================
# Optional: Google API Key (if using Google provider)
# ============================================================
GOOGLE_API_KEY=