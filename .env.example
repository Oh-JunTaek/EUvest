# 실제 값을 이 파일에 저장하거나 Git에 올리지 마세요. 개인 로컬 .env 등에 직접 설정하세요.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_ACCOUNT_ALIAS=KIS_PRIMARY
KIS_ACCOUNT_NUMBER=
KIS_HTS_ID=
# 외부 무료 LLM은 제공자별 환경변수를 로컬에서 설정
INVEST_LLM_BASE_URL=
INVEST_LLM_MODEL=
INVEST_LLM_API_KEY=
# 로컬 Ollama 모델의 로컬 호스트(외부 노출 금지)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# 선택적 OpenDART 인증키
OPENDART_API_KEY=
